    "pages": [
      {
        "slug": "home",
        "title": "Início",
        "sections": [
          {
            "id": "abertura",
            "moduleCode": "hero",
            "config": {
              "eyebrow": "Pizzaria e delivery",
              "headline": "Peça sua pizza direto pelo WhatsApp",
              "subtitle": "São 25 sabores em três tamanhos, além de lasanha e macarrão na chapa. Monte o pedido aqui e escolha entrega ou retirada no balcão.",
              "imageUrl": "/assets/pizza-demo-hero.webp",
              "imageAlt": "Pizza inteira com mussarela derretida, tomate e manjericão fresco",
              "primaryAction": {
                "label": "Ver o cardápio",
                "target": "selecao"
              },
              "secondaryAction": {
                "label": "Falar no WhatsApp",
                "target": "whatsapp"
              }
            }
          },
          {
            "id": "destaques",
            "moduleCode": "highlights",
            "config": {
              "items": [
                {
                  "icon": "mensagem",
                  "text": "Pedido direto no WhatsApp, sem aplicativo"
                },
                {
                  "icon": "entrega",
                  "text": "Delivery: (31) 3582-8479"
                },
                {
                  "icon": "local",
                  "text": "Retirada no balcão"
                },
                {
                  "icon": "estrela",
                  "text": "Pizza fatia + refri 200 ml por R$ 9,90"
                }
              ]
            }
          },
          {
            "id": "itens",
            "moduleCode": "catalog_grid",
            "config": {
              "columns": 2
            }
          },
          {
            "id": "perguntas",
            "moduleCode": "faq",
            "config": {
              "title": "Como pedir",
              "items": [
                {
                  "q": "Como escolho o tamanho?",
                  "a": "No próprio cartão da pizza: Média, Grande ou Gigante. O preço muda na hora."
                },
                {
                  "q": "Dá para pedir meio a meio ou com borda recheada?",
                  "a": "Dá. Escolha o segundo sabor em \"Meio a meio com\"; vale o preço do sabor mais caro. A borda de catupiry ou cheddar custa R$ 9,90 na Média, R$ 12,90 na Grande e R$ 14,90 na Gigante."
                },
                {
                  "q": "Como pago?",
                  "a": "Pix, cartão na entrega ou dinheiro. Se for dinheiro, diga para quanto precisa de troco."
                }
              ]
            }
          }
        ]
      }
    ]
