{
  "name": "vitrine-inspira",
  "main": "workers/api.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://qawlpsrfewosxsfgmmpm.supabase.co",
    "PUBLIC_SITE_ORIGIN": "https://vitrine.inspira.dev.br",
    "PORTAL_ORIGIN": "https://painel.inspira.dev.br"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "!/styles.css",
      "!/app.js",
      "!/categories.js",
      "!/theme.js",
      "!/assets/*",
      "!/vitrine/vitrine.css",
      "!/vitrine/vitrine.js",
      "!/por-cidade/por-cidade.css",
      "!/como-funciona",
      "!/como-funciona/*",
      "!/possibilidades",
      "!/possibilidades/*",
      "!/planos",
      "!/planos/*",
      "!/orcamento",
      "!/orcamento/*",
      "!/data/portfolio.json",
      "!/data/contact.json",
      "/*"
    ]
  }
}
