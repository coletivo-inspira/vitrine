{
  "name": "vitrine-inspira",
  "main": "workers/api.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://qawlpsrfewosxsfgmmpm.supabase.co"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "!/index.html",
      "!/404",
      "!/404.html",
      "!/styles.css",
      "!/app.js",
      "!/categories.js",
      "!/theme.js",
      "!/assets/*",
      "!/portal",
      "!/portal/*",
      "!/vitrine",
      "!/vitrine/*",
      "!/data/portfolio.json",
      "!/data/contact.json",
      "/*"
    ]
  }
}
